<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GameActivity extends AppCompatActivity → theme must descend from Theme.AppCompat.
         Not fullscreen: keep the system status bar visible so the app doesn't draw under it. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#1763D6</item>
        <item name="android:navigationBarColor">#111318</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
